// Emlang Compositional Grammar - The Next Evolution
// Building on the Sigil foundation with transformer emoji, pattern matching, and more
//
// PHASE 1A: Transformer Emoji (Higher-Order Operators)
// Transformers operate ON other emoji, creating compositional semantics
//
// Evolution from Sigil:
// - Adds 8 transformer emoji as higher-order operators
// - Transformers compose with elements and containers
// - Pattern matching with ⟨⟩ delimiters
// - Preserves all sigil semantics and feature propagation
//
// Philosophy: Visual symbols as operators, not just terminals
// Form encodes function, structure reveals semantics

// === TOP-LEVEL STRUCTURE ===
// Sigil is the top-level category - any valid expression
// Integrates sigil-emoji-native's linguistic richness with new transformers
Sigil -> Element
Sigil -> Container
Sigil -> Composite
Sigil -> TransformedElement
Sigil -> TransformedContainer
Sigil -> ComposedTransform
Sigil -> Pattern
Sigil -> QuantifiedPattern
Sigil -> TransformedPattern
Sigil -> AnnotatedContainer
Sigil -> AnnotatedElement
Sigil -> AnnotatedPattern
Sigil -> AnnotatedComposite
Sigil -> AnnotatedTransformed

// === ANNOTATED STRUCTURES (from sigil-emoji-native) ===
// Linguistic markers that add semantic richness
// Following compositional symmetry: if a marker can annotate containers,
// it can also annotate elements, patterns, and other structures

AnnotatedContainer -> Evidential Container
AnnotatedContainer -> Honorific Container
AnnotatedContainer -> Modal Container
AnnotatedContainer -> Aspectual Container
AnnotatedContainer -> Directional Container
AnnotatedContainer -> SemanticRole Container

AnnotatedElement -> Evidential Element
AnnotatedElement -> Honorific Element
AnnotatedElement -> Modal Element
AnnotatedElement -> Aspectual Element
AnnotatedElement -> Directional Element
AnnotatedElement -> Attunement Element
AnnotatedElement -> Animacy Element
AnnotatedElement -> SemanticRole Element

// Patterns can also be annotated
AnnotatedPattern -> Evidential Pattern
AnnotatedPattern -> Honorific Pattern
AnnotatedPattern -> Modal Pattern
AnnotatedPattern -> Aspectual Pattern
AnnotatedPattern -> Directional Pattern
AnnotatedPattern -> SemanticRole Pattern

AnnotatedComposite -> TemporalDistance Composite
AnnotatedComposite -> Clusivity Composite
AnnotatedComposite -> SwitchRef Composite

// NEW: Annotated transformations!
// Following compositional symmetry: each linguistic marker can annotate
// any transformation type (TransformedElement, TransformedContainer, ComposedTransform)

// Evidentials (epistemic source) on transformations
AnnotatedTransformed -> Evidential TransformedElement
AnnotatedTransformed -> Evidential TransformedContainer
AnnotatedTransformed -> Evidential ComposedTransform

// Aspects (temporal structure) on transformations
AnnotatedTransformed -> Aspectual TransformedElement
AnnotatedTransformed -> Aspectual TransformedContainer
AnnotatedTransformed -> Aspectual ComposedTransform

// Modals (necessity/possibility) on transformations
AnnotatedTransformed -> Modal TransformedElement
AnnotatedTransformed -> Modal TransformedContainer
AnnotatedTransformed -> Modal ComposedTransform

// Directionality (energy flow) on transformations
AnnotatedTransformed -> Directional TransformedElement
AnnotatedTransformed -> Directional TransformedContainer
AnnotatedTransformed -> Directional ComposedTransform

// Semantic roles on transformations (Phase 2)
AnnotatedTransformed -> SemanticRole TransformedElement
AnnotatedTransformed -> SemanticRole TransformedContainer
AnnotatedTransformed -> SemanticRole ComposedTransform

// === TRANSFORMER EMOJI (Phase 1A) ===
// These are higher-order operators that transform other emoji
// Start as simple terminals - semantic evaluation comes in later phases

// 🎭 Morph/Transform - state changes and metamorphosis
Transformer[ op: morph, semantics: state_change ] -> 🎭

// 🔄 Recursion/Loop - infinite iteration and self-reference
Transformer[ op: recursion, semantics: infinite_loop ] -> 🔄

// 🧬 Pattern Replication - multiply and replicate patterns
Transformer[ op: replicate, semantics: pattern_multiply ] -> 🧬

// 📦 Package/Encapsulate - defer evaluation, create thunks
Transformer[ op: package, semantics: defer_eval ] -> 📦

// 🔗 Bind/Link - create relationships and connections
Transformer[ op: bind, semantics: create_link ] -> 🔗

// ⚡ Force Evaluation - immediate execution, strict evaluation
Transformer[ op: force, semantics: immediate_eval ] -> ⚡

// 🌀 Lazy/Suspend - suspend evaluation, create promises
Transformer[ op: lazy, semantics: suspend_eval ] -> 🌀

// 🪞 Reflection - meta-examination and introspection
Transformer[ op: reflect, semantics: meta_examine ] -> 🪞

// === TRANSFORMER APPLICATION RULES ===
// Transformers apply to elements, containers, patterns, or sigils
// The transformation type propagates through feature structures

// Transformer + Element creates a transformed element
TransformedElement[ transform: #t ] -> Transformer[ op: #t ] Element

// Transformer + Container creates a transformed container
TransformedContainer[ transform: #t ] -> Transformer[ op: #t ] Container

// Transformer + Pattern creates a transformed pattern
// Example: 🔄 popen 🔥 por 💧 pclose = recursive pattern matching
TransformedPattern[ transform: #t ] -> Transformer[ op: #t ] Pattern

// Multiple transformers compose left-to-right
// Example: 🔄 📦 🔥 = recursively packaged fire
ComposedTransform[ transform1: #t1, transform2: #t2 ] -> Transformer[ op: #t1 ] Transformer[ op: #t2 ] Element
ComposedTransform[ transform1: #t1, transform2: #t2 ] -> Transformer[ op: #t1 ] Transformer[ op: #t2 ] Container

// === LINGUISTIC MARKERS (from sigil-emoji-native) ===
// Rich semantic annotations inspired by natural language typology

// EVIDENTIALITY: How we know (epistemic source)
Evidential[ evid: direct ] -> 👁️
Evidential[ evid: inferred ] -> 🔍
Evidential[ evid: hearsay ] -> 👂
Evidential[ evid: intuitive ] -> 🔮

// ASPECT: Temporal structure of events
Aspectual[ aspect: habitual ] -> 🔁
Aspectual[ aspect: perfective ] -> ✅
Aspectual[ aspect: progressive ] -> ▶️
Aspectual[ aspect: inceptive ] -> 🌱
Aspectual[ aspect: cessative ] -> 🛑

// ATTUNEMENT: Relationship to magical elements
Attunement[ attune: natural ] -> 🌿
Attunement[ attune: forced ] -> 🔨
Attunement[ attune: harmonious ] -> ☯️
Attunement[ attune: discordant ] -> ⚔️

// HONORIFICS: Respect level (social deixis)
Honorific[ honor: humble ] -> 🙇
Honorific[ honor: neutral ] -> 😐
Honorific[ honor: honorific ] -> 🙏
Honorific[ honor: sacred ] -> 👑

// ANIMACY: Consciousness level (ontological hierarchy)
Animacy[ anim: sentient ] -> 🧠
Animacy[ anim: living ] -> 💚
Animacy[ anim: spiritual ] -> 👻
Animacy[ anim: inert ] -> 🪨

// DIRECTIONALITY: Energy flow vectors
Directional[ direction: upward ] -> ⬆️
Directional[ direction: downward ] -> ⬇️
Directional[ direction: inward ] -> ⏺️
Directional[ direction: outward ] -> 💫
Directional[ direction: cyclical ] -> ⭕

// MODAL: Necessity and possibility (deontic/epistemic modality)
Modal[ mode: potential ] -> 🤔
Modal[ mode: necessary ] -> ❗
Modal[ mode: prohibited ] -> 🚫
Modal[ mode: obligated ] -> 📋
Modal[ mode: desired ] -> ⭐

// SWITCH-REFERENCE: Topic/focus tracking
SwitchRef[ switch: same ] -> ➡️
SwitchRef[ switch: different ] -> 🔀
SwitchRef[ switch: reflexive ] -> 🪞

// TEMPORAL DISTANCE: How far in time
TemporalDistance[ time: immediate ] -> ⚡
TemporalDistance[ time: recent ] -> 📅
TemporalDistance[ time: remote ] -> 🏛️

// CLUSIVITY: Who participates (inclusive/exclusive distinction)
Clusivity[ clus: inclusive ] -> 👥
Clusivity[ clus: exclusive ] -> 🚶🚶
Clusivity[ clus: solo ] -> 🧍

// === SEMANTIC ROLES (Phase 2) ===
// Thematic roles inspired by ergative-absolutive languages and case systems
// These mark the semantic relationship between participants and actions

// AGENT: The performer of an action (volitional actor)
// Example: 🤌 🧠 🔥 = sentient fire as agent
SemanticRole[ role: agent, volition: high ] -> 🤌

// PATIENT: The receiver or undergoer of an action (affected entity)
// Example: 🎯 💧 = water as patient (being acted upon)
SemanticRole[ role: patient, affected: true ] -> 🎯

// INSTRUMENT: The tool or means by which action is performed
// Example: 🛠️ ‹ › = using amplification as instrument
SemanticRole[ role: instrument, tool: true ] -> 🛠️

// BENEFICIARY: The entity for whose benefit action is performed
// Example: 🎁 🌿 = for nature's benefit
SemanticRole[ role: beneficiary, recipient: true ] -> 🎁

// LOCATION: The place or spatial setting of action
// Example: 📍 ⬆️ = located upward
SemanticRole[ role: locative, spatial: true ] -> 📍

// TIME: The temporal setting or timing of action
// Example: ⏰ 🏛️ = at ancient time
SemanticRole[ role: temporal, when: true ] -> ⏰

// === PATTERN MATCHING (Phase 1B) ===
// Pattern delimiters using mathematical angle brackets ⟨⟩
// Start with simple alternation (OR) patterns

// Pattern wrapper
Pattern -> POpen PatternContent PClose

// Pattern content - alternation (OR) matching
// Supports 2+ elements through recursion
// ⟨🔥|💧⟩ = match fire OR water
// ⟨🔥|💧|💨|🌍⟩ = match any of four elements
// Also supports annotated elements in patterns
PatternContent -> Element POr Element
PatternContent -> Element POr PatternContent
PatternContent -> AnnotatedElement POr AnnotatedElement
PatternContent -> AnnotatedElement POr PatternContent
PatternContent -> Element POr AnnotatedElement
PatternContent -> AnnotatedElement POr Element

// Pattern terminals - word-based for now (Unicode tokenization needs investigation)
POpen -> popen
PClose -> pclose
POr -> por

// === CONTAINERS ===
// Four container types from Sigil, each with distinct semantics
// Containers modify or propagate features from contents

// Amplifier ‹ › - increases energy, propagates features upward
Container[ type: amplify, energy: #e ] -> AmpOpen Contents[ energy: #e ] AmpClose

// Stabilizer ⟦ ⟧ - grounds volatile elements, reduces energy
Container[ type: stabilize, energy: low ] -> StabOpen Contents[ energy: #e ] StabClose

// Transformer ❴ ❵ - allows element fusion, creates emergent states
Container[ type: transform ] -> TransOpen FusedContents TransClose

// Channeler ⦅ ⦆ - directs energy, preserves all properties
Container[ type: channel, energy: #e, state: #s ] -> ChanOpen Contents[ energy: #e, state: #s ] ChanClose

// === CONTENTS ===
// Recursive contents allow arbitrary nesting depth
// Each level of nesting adds semantic complexity
// Supports transformers, linguistic annotations, and all compositional forms

Contents -> Element
Contents -> Element Contents
Contents -> Container
Contents -> Container Contents
Contents -> TransformedElement
Contents -> TransformedElement Contents
Contents -> TransformedContainer
Contents -> TransformedContainer Contents
Contents -> AnnotatedElement
Contents -> AnnotatedElement Contents
Contents -> AnnotatedContainer
Contents -> AnnotatedContainer Contents

// Fused contents for transformer containers
// Allows element fusion with operators
// Supports annotated elements, transformed elements, and containers for rich fusion
FusedContents -> Element Operator Element
FusedContents -> Element Operator Element Operator Element
FusedContents -> Element
FusedContents -> PowerElement
FusedContents -> Container Operator Element
FusedContents -> Element Operator Container
FusedContents -> Container Operator Container
FusedContents -> AnnotatedElement Operator AnnotatedElement
FusedContents -> AnnotatedElement Operator Element
FusedContents -> Element Operator AnnotatedElement
FusedContents -> AnnotatedElement
FusedContents -> TransformedElement Operator TransformedElement
FusedContents -> TransformedElement Operator Element
FusedContents -> Element Operator TransformedElement

// === POWER ELEMENTS ===
// Repeated elements = stronger manifestation
// 🔥🔥 = double fire, 🔥🔥🔥 = triple fire = extreme power
// Feature: base tracks the element type being repeated
PowerElement[ base: #t ] -> Element[ type: #t ] Element[ type: #t ]
PowerElement[ base: #t ] -> Element[ type: #t ] PowerElement[ base: #t ]

// === COMPOSITE STRUCTURES ===
// Juxtaposition and explicit operations
Composite -> Sigil Operator Sigil
Composite -> Sigil Sigil

// === ELEMENTS (Base Symbols) ===
// Five fundamental elements with inherent properties
// Properties propagate through feature unification

// 🔥 Fire - high energy, volatile, aggressive
Element[ type: fire, energy: high, state: volatile, aspect: aggressive ] -> 🔥

// 💧 Water - medium energy, flowing, adaptive
Element[ type: water, energy: medium, state: flowing, aspect: adaptive ] -> 💧

// 💨 Air - medium energy, free, swift
Element[ type: air, energy: medium, state: free, aspect: swift ] -> 💨

// 🌍 Earth - low energy, solid, protective
Element[ type: earth, energy: low, state: solid, aspect: protective ] -> 🌍

// 🌑 Void - no energy, ethereal, mysterious
Element[ type: void, energy: none, state: ethereal, aspect: mysterious ] -> 🌑

// === OPERATORS ===
// Combine, negate, or create barriers between elements
Operator -> plus
Operator -> minus
Operator -> pipe

// === CONTAINER DELIMITERS ===
// Using Unicode brackets for visual clarity
AmpOpen -> ‹
AmpClose -> ›
StabOpen -> ⟦
StabClose -> ⟧
TransOpen -> ❴
TransClose -> ❵
ChanOpen -> ⦅
ChanClose -> ⦆

// ======================================================================
// === PHASE 1C: ADVANCED COMPOSITIONAL FEATURES ===
// Implementing variable binding, pattern matching semantics, and
// meta-operators using PURE .fgr GRAMMAR techniques
//
// KEY INSIGHT: Feature grammars can express complex semantics without
// external evaluation code! Tags provide variable unification, multiple
// productions provide alternation, and rewrite rules provide evaluation.
//
// Inspired by examples/dative-shift.fgr and examples/reflexives.fgr
// ======================================================================

// === DYNAMIC VARIABLE BINDING (Phase 1C) ===
// Variables bind to emoji values via feature tag unification
// TWO-DIMENSIONAL TAGS: #n = variable NAME, #v = variable VALUE
//
// Syntax: "x bind 🔥 arrow x" instead of subscripts like 🔥ₓ
// This approach requires NO lexer changes, pure grammar!
//
// The magic: Both name and value must unify for valid reference
// Wrong variable name → unification fails → 0 parses (semantic error!)

// Add variable binding expressions to top level
Sigil -> VarExpr

// Variable expression: bind variable, use in result
VarExpr[ var: #n, val: #v, result: #r ] -> VarBinding[ var_name: #n, var_value: #v ] VarArrow VarResult[ needs_var: #n, has_val: #v, yields: #r ]

// Binding: associate variable name with element/container/pattern
VarBinding[ var_name: #n, var_value: #v ] -> Variable[ name: #n ] BindOp Element[ type: #v ]
VarBinding[ var_name: #n, var_value: #c ] -> Variable[ name: #n ] BindOp Container[ type: #c ]
VarBinding[ var_name: #n, var_value: pattern ] -> Variable[ name: #n ] BindOp Pattern

// Variable reference - returns bound value
VarResult[ needs_var: #n, has_val: #v, yields: #v ] -> Variable[ name: #n ]

// Variable reference with operation
VarResult[ needs_var: #n, has_val: #v, yields: combined ] -> Variable[ name: #n ] Operator Element
VarResult[ needs_var: #n, has_val: #v, yields: combined ] -> Variable[ name: #n ] Operator Container

// Variable names - extensible! Add more as needed
// Can use ascii (x, y, z) or unicode (α, β, γ)
Variable[ name: x ] -> x
Variable[ name: y ] -> y
Variable[ name: z ] -> z
Variable[ name: a ] -> a
Variable[ name: b ] -> b
Variable[ name: c ] -> c
Variable[ name: alpha ] -> α
Variable[ name: beta ] -> β
Variable[ name: gamma ] -> γ
Variable[ name: delta ] -> δ

// Binding operators
BindOp -> bind
VarArrow -> arrow

// === PATTERN MATCHING SEMANTICS (Phase 1B continued) ===
// Patterns declare what types they CAN match via features
// Matching enforced through tag unification - pure grammar!
//
// Example: popen 🔥 por 💧 pclose can match EITHER fire OR water
// The grammar creates multiple productions with different can_match features

// Add pattern matching expressions to top level
Sigil -> PatternMatch

// Pattern match expression: pattern matches element
// Tag #t must unify between pattern's can_match and element's type!
// If types incompatible, unification fails → 0 parses
PatternMatch[ matched: #t, result: success ] -> Pattern[ can_match: #t ] MatchOp Element[ type: #t ]

// Patterns can match different types via multiple productions
// Two-element OR pattern can match first element
Pattern[ can_match: fire ] -> POpen Element[ type: fire ] POr Element[ type: water ] PClose
Pattern[ can_match: water ] -> POpen Element[ type: fire ] POr Element[ type: water ] PClose

// Two-element OR pattern can match second element
Pattern[ can_match: fire ] -> POpen Element[ type: water ] POr Element[ type: fire ] PClose
Pattern[ can_match: water ] -> POpen Element[ type: water ] POr Element[ type: water ] PClose

// Three-element OR pattern - all combinations
Pattern[ can_match: fire ] -> POpen Element[ type: fire ] POr Element[ type: water ] POr Element[ type: air ] PClose
Pattern[ can_match: water ] -> POpen Element[ type: fire ] POr Element[ type: water ] POr Element[ type: air ] PClose
Pattern[ can_match: air ] -> POpen Element[ type: fire ] POr Element[ type: water ] POr Element[ type: air ] PClose

// Single-element patterns
Pattern[ can_match: fire ] -> POpen Element[ type: fire ] PClose
Pattern[ can_match: water ] -> POpen Element[ type: water ] PClose
Pattern[ can_match: air ] -> POpen Element[ type: air ] PClose
Pattern[ can_match: earth ] -> POpen Element[ type: earth ] PClose
Pattern[ can_match: void ] -> POpen Element[ type: void ] PClose

// Match operator
MatchOp -> matches

// === META-OPERATOR: EVALUATION (⇒) ===
// Evaluation as structural transformation via rewrite rules
// Like Vdative -> Vbare in examples/dative-shift.fgr!
//
// Unevaluated forms REWRITE to evaluated forms
// Features encode transformation semantics

// Add evaluation expressions to top level
Sigil -> EvalExpr

// Evaluation expression: show transformation
EvalExpr[ before: #b, after: #a ] -> Unevaluated[ form: #b ] EvalArrow Evaluated[ was: #b, becomes: #a ]

// Unevaluated recursive containers
Unevaluated[ form: recursive_fire ] -> RecurseOp Element[ type: fire ]
Unevaluated[ form: recursive_water ] -> RecurseOp Element[ type: water ]
Unevaluated[ form: recursive_container ] -> RecurseOp Container

// Evaluated form: REWRITE RULE transforms structure!
// This is the key: Evaluated -> Unevaluated is structural transformation
Evaluated[ was: recursive_fire, becomes: amplified ] -> Unevaluated[ form: recursive_fire ]
Evaluated[ was: recursive_water, becomes: stabilized ] -> Unevaluated[ form: recursive_water ]
Evaluated[ was: recursive_container, becomes: channeled ] -> Unevaluated[ form: recursive_container ]

// Evaluation operators
RecurseOp -> recurse
EvalArrow -> eval

// === META-OPERATOR: DEFINITION (≡) ===
// Definition operator for creating named bindings within expressions
// Like let-binding in functional languages
//
// Syntax: star define ❴ 🔥 plus 💧 ❵ then star plus star
//
// TWO-DIMENSIONAL TAGS: #n = definition NAME, #v = definition VALUE
// Both must unify for valid reference (wrong name → 0 parses)
//
// Inspired by variable binding (VarExpr) - same pattern, different domain

// Add definition expressions to top level
Sigil -> DefExpr

// Definition expression: bind symbol to value, use in result
DefExpr[ def: #n, val: #v, result: #r ] -> DefBinding[ def_name: #n, def_value: #v ] DefArrow DefResult[ needs_def: #n, has_val: #v, yields: #r ]

// Binding: associate definition symbol with any Sigil
DefBinding[ def_name: #n, def_value: #v ] -> DefSymbol[ name: #n ] DefOp Sigil[ expr: #v ]

// Definition reference - returns bound value
// Tags #n and #v must BOTH unify for valid reference!
DefResult[ needs_def: #n, has_val: #v, yields: #v ] -> DefSymbol[ name: #n ]

// Definition can be used in operations
DefResult[ needs_def: #n, has_val: #v, yields: combined ] -> DefSymbol[ name: #n ] Operator Sigil
DefResult[ needs_def: #n, has_val: #v, yields: combined ] -> Sigil Operator DefSymbol[ name: #n ]
DefResult[ needs_def: #n, has_val: #v, yields: combined ] -> DefSymbol[ name: #n ] Operator DefSymbol[ name: #n ]

// Predefined definition symbols (finite but extensible set)
// Following PARADIGM-SHIFT.md: can't create NEW symbols dynamically,
// but can provide a useful set of definition slots
// Using word-based markers like variables (x, y, z)
DefSymbol[ name: star ] -> star
DefSymbol[ name: circus ] -> circus
DefSymbol[ name: castle ] -> castle
DefSymbol[ name: temple ] -> temple
DefSymbol[ name: rainbow ] -> rainbow

// Definition operators (word-based for consistency)
DefOp -> define
DefArrow -> then

// === META-OPERATOR: COMPOSITION (∘) ===
// Composition operator creates first-class composed transformers
// Mathematical function composition: (f ∘ g)(x) = f(g(x))
//
// Syntax: 🔄 compose 📦 apply 🔥
// Result: First package, then recurse (right-to-left application)
//
// This is different from ComposedTransform (🔄 📦 🔥):
// - ComposedTransform: direct sequential application
// - Composition operator: creates REUSABLE composed transformer
//
// The composed operator can be applied to multiple targets

// Add composition expressions to top level
Sigil -> CompExpr

// Composition expression: compose two transformers, apply to target
CompExpr[ first: #t1, second: #t2, target: #tgt, result: composed ] -> ComposedOp[ op1: #t1, op2: #t2 ] CompApply CompTarget[ applies_to: #tgt ]

// Composed operator: combines two transformers into one
// Right-to-left application: compose f g = f ∘ g means "first g, then f"
ComposedOp[ op1: #t1, op2: #t2 ] -> Transformer[ op: #t1 ] CompOp Transformer[ op: #t2 ]

// Target that composed operator applies to
// Can apply to base structures
CompTarget[ applies_to: element ] -> Element
CompTarget[ applies_to: container ] -> Container
CompTarget[ applies_to: pattern ] -> Pattern

// Can also apply to already-transformed structures
CompTarget[ applies_to: transformed ] -> TransformedElement
CompTarget[ applies_to: transformed ] -> TransformedContainer
CompTarget[ applies_to: transformed ] -> ComposedTransform

// Can apply to power elements and annotated structures
CompTarget[ applies_to: power ] -> PowerElement
CompTarget[ applies_to: annotated ] -> AnnotatedElement
CompTarget[ applies_to: annotated ] -> AnnotatedContainer

// Composition operators (word-based for clarity)
CompOp -> compose
CompApply -> apply

// ======================================================================
// === PHASE 1D: PATTERN QUANTIFIERS (COMBINATORS) ===
// Pattern repetition quantifiers: *, +, ?
//
// KEY DESIGN INSIGHT: Quantifiers bridge TWO semantic domains:
// 1. COMPUTATIONAL: "zero or more" (like regex)
// 2. ONTOLOGICAL: PowerElement intensity (🔥🔥 = double fire)
//
// Solution: Quantifiers match BOTH single elements AND PowerElement structures!
//
// Semantic mapping:
// - qstar (*) → matches: nothing, 🔥, 🔥🔥, 🔥🔥🔥, ...
// - qplus (+) → matches: 🔥, 🔥🔥, 🔥🔥🔥, ... (no zero!)
// - qopt  (?) → matches: nothing, 🔥 (zero or one only)
//
// This maintains coherence because PowerElement IS repeated manifestation!
// ======================================================================

// Add quantified matching to top level
Sigil -> QuantifiedMatch

// === QUANTIFIER TERMINALS ===
// Word-based markers (no Unicode tokenization changes needed)
QuantStar -> qstar   // Zero or more (Kleene star)
QuantPlus -> qplus   // One or more
QuantOpt -> qopt     // Optional (zero or one)

// === QUANTIFIED PATTERNS ===
// Patterns with quantifiers - track what they can match

// qstar: can match any count including zero
QuantifiedPattern[ quant: star, matches: #t ] -> POpen Element[ type: #t ] QuantStar PClose

// qplus: requires at least one
QuantifiedPattern[ quant: plus, matches: #t ] -> POpen Element[ type: #t ] QuantPlus PClose

// qopt: zero or exactly one
QuantifiedPattern[ quant: opt, matches: #t ] -> POpen Element[ type: #t ] QuantOpt PClose

// === QUANTIFIED MATCHING RULES ===
// Multiple productions handle different match cases
// Pattern semantics enforced through feature unification!

// ZERO MATCH: qstar and qopt can match zero elements
// Special terminal "matches-zero" for this case
QuantifiedMatch[ quant: star, matched: #t, count: zero ] -> QuantifiedPattern[ quant: star, matches: #t ] MatchZero
QuantifiedMatch[ quant: opt, matched: #t, count: zero ] -> QuantifiedPattern[ quant: opt, matches: #t ] MatchZero

// ONE MATCH: all quantifiers can match single element
// Tag #q unifies with any quantifier, tag #t enforces type matching
QuantifiedMatch[ quant: #q, matched: #t, count: one ] -> QuantifiedPattern[ quant: #q, matches: #t ] MatchOp Element[ type: #t ]

// MULTIPLE MATCH: qstar and qplus match PowerElement
// PowerElement[ base: #t ] must unify with pattern's matches: #t
// This is the key: PowerElement represents repeated manifestation!
QuantifiedMatch[ quant: star, matched: #t, count: multiple ] -> QuantifiedPattern[ quant: star, matches: #t ] MatchOp PowerElement[ base: #t ]
QuantifiedMatch[ quant: plus, matched: #t, count: multiple ] -> QuantifiedPattern[ quant: plus, matches: #t ] MatchOp PowerElement[ base: #t ]

// Note: qopt does NOT match PowerElement (only zero or one!)
// Semantic constraint enforced through absence of production
// Attempting to match qopt with PowerElement → 0 parses ✅

// === MATCHING OPERATORS ===
// matches: general matching operator (already defined)
// matches-zero: special operator for zero-count matches
MatchZero -> matches-zero
